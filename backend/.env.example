DATABASE_URL=postgresql://postgres:postgres@localhost:5432/event_booking?schema=public
PORT=4000
NODE_ENV=development
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
FRONTEND_URL=http://localhost:5173
COOKIE_SECRET=change-this-cookie-secret-at-least-32-characters
# Optional shared rate-limit store; leave unset for local development.
# REDIS_URL=redis://localhost:6379

# Direct local access: 0. Set to the exact number of trusted proxy hops in deployment.
TRUST_PROXY_HOPS=0
